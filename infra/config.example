# Per-developer configuration for openshift-install.
# Copy this file to 'config' and customize:
#
#   cp config.example config
#
# 'config' is gitignored — it contains per-developer values.

# Pick a unique name (lowercase, hyphens, max 27 chars for openshift-install)
CLUSTER_NAME="CHANGEME-perf"

# Route53 hosted zone in the target AWS account
BASE_DOMAIN="aws.rhaiseng.com"

# AWS region — must match the Route53 hosted zone
AWS_REGION="us-east-1"

# Instance types — README recommends m5.8xlarge masters, m5.2xlarge workers
MASTER_TYPE="m5.8xlarge"
WORKER_TYPE="m5.2xlarge"
WORKER_REPLICAS=3

# Pull secret from https://console.redhat.com/openshift/install/pull-secret
PULL_SECRET_FILE="$HOME/.openshift/pull-secret.json"

# SSH public key for node access (optional but recommended for debugging)
SSH_KEY_FILE="$HOME/.ssh/id_rsa.pub"

# OCP version (major.minor) — create-cluster.sh resolves the latest z-stream
OCP_VERSION="4.21"
